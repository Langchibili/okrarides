# .env.example

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:1343/api
NEXT_UPLOAD_PUBLIC_API_URL=http://localhost:1343
NODE_ENV=development
# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_SECRET==
NEXT_PUBLIC_APPLE_MAPS_TOKEN=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
# Yandex Maps JavaScript API key (for in-iframe JS API if ever needed)
# Also used by YandexMapsProvider for Geocoder + Suggest HTTP APIs
# Get from: https://developer.tech.yandex.com/ → "JavaScript API and HTTP Geocoder"
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_MAPS_GEOCODER_AND_JAVASCRIPITAPI_KEY=
NEXT_PUBLIC_YANDEX_GEOSUGGESTAPIKEY=
NEXT_PUBLIC_YANDEX_GEOLOCATOR=
# URL of your self-hosted geo-server accessible from the browser
# Used for: routing, tiles fallback, IP geolocation, and initial map location
# In production this should be your public domain, e.g. https://maps.yourdomain.com
NEXT_PUBLIC_LOCALLY_HOSTED_MAP_SERVER_URL=

# WebSocket Server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3005
NEXT_PUBLIC_DEVICE_SOCKET_URL=http://localhost:3006


# App URLs
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_RIDER_APP_URL=http://localhost:3001 
NEXT_PUBLIC_DRIVER_APP_URL=http://localhost:3002
NEXT_PUBLIC_CONDUCTOR_APP_URL=
NEXT_PUBLIC_DELIVERY_APP_URL=http://localhost:3003

# SMS Service (Africa's Talking)
NEXT_PUBLIC_AFRICAS_TALKING_API_KEY=your_api_key
NEXT_PUBLIC_AFRICAS_TALKING_USERNAME=your_username

# Payment Gateway (OkraPay)
NEXT_PUBLIC_OKRAPAY_PUBLIC_KEY=your_public_key
OKRAPAY_SECRET_KEY=your_secret_key
OKRAPAY_WEBHOOK_URL=http://localhost:3000/api/webhooks/okrapay

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_id